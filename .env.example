# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for guest uploads.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL, used for share links and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it to /api/cron/cleanup.
CRON_SECRET=

# Stripe (Dashboard -> Developers). Webhook endpoint: <site>/api/stripe/webhook
# events: checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email via Resend (resend.com). EMAIL_FROM must be on a domain you verified, e.g. "Hapstoria <hello@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=
PRINT_NOTIFY_EMAIL=
ADMIN_EMAILS=
