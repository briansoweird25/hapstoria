# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for guest uploads.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL, used for share links and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show "Continue with Google" on the login page. Only set to true after enabling the Google provider in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Random string (e.g. `openssl rand -hex 32`). The Netlify scheduled functions send it to /api/cron/*.
CRON_SECRET=

# GCash / Maya / cards via PayMongo (dashboard.paymongo.com -> Developers). Use the test keys first.
# Webhook URL to register: <site>/api/paymongo/webhook  (event: checkout_session.payment.paid)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# PayPal (developer.paypal.com -> Apps & Credentials). PAYPAL_ENV is "sandbox" until you go live, then "live".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Email via Resend (resend.com). EMAIL_FROM must be on a domain you verified, e.g. "Hapstoria <hello@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=
PRINT_NOTIFY_EMAIL=
ADMIN_EMAILS=
